<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0 viewport-fit=cover"
    />
    <link rel="stylesheet" href="/static/style.css" />
    <title>Samambaia</title>
  </head>
  <body>
    <header class="header">
      <img
        class="img-logo"
        src="/static/imgs/logo samambaia cinza.png"
        alt="samambaia bar e lanches"
      />
    </header>

    <main class="box-section">
        <header class="box-content-top">
          
          <nav class="nav-list">
            <% categorias.forEach(categoria => { %>
              <button class="nav-btn">
                <a href="#<%= slugify(categoria.title) %>"><%= categoria.title %></a>
              </button>
            <% }) %>
          </nav>
          
        </header>
        <main class="box-content-bottom">
          <% categorias.forEach(categoria => { %>
            <section id="<%= slugify(categoria.title) %>">
              <div>
                <p class="categoria"><%= categoria.title %></p>
              </div>
              <% categoria.products.forEach(produto => { %>
                <div class="menu-items box-container">
                  <div class="item box-container">
                    <% if (produto.filename) { %>
                      <img
                        class="item-img"
                        src="/uploads/<%= produto.filename %>"
                        alt="<%= produto.title %>"
                      />
                    <% } else { %>
                      <img src="/static/imgs/SEMFOTO.JPG" alt="Sem imagem" class="item-img">
                    <% } %>
                    <div class="item-text">
                      <h2><%= produto.title %></h2>
                      <p><%= produto.description || '' %></p>
                      <span>R$ <%= produto.price.toFixed(2) %></span>
                    </div>
                  </div>
                </div>
              <% }) %>
            </section>
          <% }) %>
        </main>
    </main>

    <script src="/static/script.js"></script>
    <script src="https://cdn.jsdelivr.net/gh/cferdinandi/smooth-scroll@16.1.3/dist/smooth-scroll.polyfills.min.js"></script>
  </body>
</html>